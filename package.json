{
  "name": "dsh-fakeip-safe-fetch",
  "version": "0.1.3",
  "description": "DNS-validated Clash/Mihomo TUN fake-IP web fetch provider for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24", "dsh": ">=0.2.0-rc.2 <=0.2.1 || 0.2.1-rc.2 || 0.2.1-rc.3" },
  "packageManager": "pnpm@11.19.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build",
    "test:compat": "node scripts/test-compat.mjs",
    "test:tun": "node scripts/test-tun.mjs",
    "test:profile": "node scripts/test-profile.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "dns-packet": "5.6.1",
    "ipaddr.js": "2.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <=4.0.5",
    "@deepseek-ai/dsh-http-proxy": ">=0.2.0-rc.2 <=0.2.1 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-timeout": ">=0.2.0-rc.2 <=0.2.1 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.2 <=0.2.1 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-web-fetch-http": ">=0.2.0-rc.2 <=0.2.1 || 0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-web": "0.2.1-rc.3",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.1-rc.3",
    "@types/dns-packet": "5.6.5",
    "@types/node": "24.12.0",
    "typescript": "5.9.3",
    "undici": "8.11.2",
    "vitest": "4.0.18",
    "yaml": "2.8.2"
  }
}
